{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "app/**",
      "features/**",
      "entities/**",
      "shared/**",
      "tests/**",
      "scripts/**",
      "*.ts",
      "*.json",
      "!next-env.d.ts",
      "!shared/api/generated",
      "!node_modules",
      "!.next"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
