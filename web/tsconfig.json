{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@sim/emcn": ["./components/ui-kit/index.ts"],
      "@sim/emcn/*": ["./components/ui-kit/*"],
      "@sim/workflow-renderer/note-colors": [
        "./lib/sim-packages/workflow-renderer/note/note-colors.ts"
      ],
      "@sim/*": ["./lib/sim-packages/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
