{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@sim/emcn": ["./components/ui-kit/index.ts"],
      "@sim/emcn/*": ["./components/ui-kit/*"],
      "@sim/db": ["./lib/sim-packages/db/index.ts"],
      "@sim/db/*": ["./lib/sim-packages/db/*"],
      "@sim/logger": ["./lib/sim-packages/logger/index.ts"],
      "@sim/realtime-protocol/*": ["./lib/sim-packages/realtime-protocol/*"],
      "@sim/security/*": ["./lib/sim-packages/security/*"],
      "@sim/utils": ["./lib/sim-packages/utils/index.ts"],
      "@sim/utils/*": ["./lib/sim-packages/utils/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "content/**/*.ts",
    "content/**/*.tsx",
    "lib/ashby/**/*.ts",
    "lib/blog/**/*.ts",
    "lib/colors/**/*.ts",
    "lib/content/**/*.ts",
    "lib/landing/**/*.ts",
    "lib/landing/**/*.tsx",
    "lib/lingxi/**/*.ts",
    "lib/lingxi/**/*.tsx",
    "lib/logger/**/*.ts",
    "lib/ui/**/*.ts",
    "lib/utils/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
