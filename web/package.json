{
  "name": "lingxilearn-web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": "1.3.6",
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "generate:api": "openapi-typescript ../server/openapi.json -o shared/api/generated/schema.ts",
    "type-check": "tsc --noEmit -p tsconfig.production.json",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "test": "vitest run",
    "check:unused": "knip --production",
    "check:boundaries": "depcruise --config dependency-cruiser.cjs app features entities shared",
    "check": "bun run type-check && bun run type-check:tests && bun run lint:check && bun run test && bun run check:unused && bun run check:boundaries"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "24.2.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "dependency-cruiser": "16.10.4",
    "knip": "5.62.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vitest": "4.1.0"
  }
}
