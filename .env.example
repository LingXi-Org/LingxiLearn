# ---------------------------------------------------------------------------
# LingxiLearn configuration. Copy to .env and edit.
# Required values are intentionally explicit: invalid composition stops startup.
# ---------------------------------------------------------------------------

# --- Docker Compose ---------------------------------------------------------
POSTGRES_DB=lingxilearn
POSTGRES_USER=lingxilearn
POSTGRES_PASSWORD=
LINGXILEARN_WEB_PORT=8080
LINGXILEARN_API_PORT=8000
# Exact Git commit published as both API and Web image tags.
LINGXILEARN_RELEASE_SHA=

# --- China mirror acceleration --------------------------------------------
# These are already the defaults. Change only if your server cannot access
# the selected mirror or you have an internal registry.
DOCKER_REGISTRY=accel.way2api.fun/docker.io
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=mirrors.aliyun.com

# --- Storage ----------------------------------------------------------------
# Compose provides the PostgreSQL DSN. Direct launches must set it explicitly.
# LINGXILEARN_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/lingxilearn

# --- Tutor brain ------------------------------------------------------------
# scripted | openai | coze
#
# Provider selection is exact. OpenAI and Coze require their own credentials;
# scripted is an explicit authored-content provider, never a substitute chosen
# after a configured provider fails.
LINGXILEARN_BRAIN=scripted

# --- OpenAI-compatible provider ---------------------------------------------
# Defaults to DeepSeek. The provider remains OpenAI-compatible so the same
# integration can still be overridden for Qwen/DashScope, Moonshot, vLLM, etc.
LINGXILEARN_LLM_MODEL=deepseek-v4-flash
LINGXILEARN_LLM_BASE_URL=https://api.deepseek.com
LINGXILEARN_LLM_API_KEY=
LINGXILEARN_LLM_TEMPERATURE=0.3
LINGXILEARN_LLM_TIMEOUT=45

# --- Agent Task runtime ---------------------------------------------------
# All new intent/subagents share this DeepSeek-compatible model.
DS_API_KEY=
LINGXILEARN_AGENT_MODEL=deepseek-v4-flash
LINGXILEARN_AGENT_BASE_URL=https://api.deepseek.com
LINGXILEARN_AGENT_TIMEOUT=90
# Research has a larger node budget than intent/visual generation.
LINGXILEARN_AGENT_LECTURE_TIMEOUT=180
LINGXILEARN_AGENT_VISUAL_TIMEOUT=240
LINGXILEARN_AGENT_DECK_TIMEOUT=360
LINGXILEARN_AGENT_DECK_RECURSION_LIMIT=80
# Timeout for one public search/fetch request; the agent can continue with other sources.
LINGXILEARN_AGENT_WEB_TIMEOUT=20
## Small-memory production defaults: queue graph work instead of OOMing.
LINGXILEARN_AGENT_CONCURRENCY=1
LINGXILEARN_DB_POOL_SIZE=3
LINGXILEARN_DB_MAX_OVERFLOW=1
LINGXILEARN_AGENT_CACHE_ENABLED=true
LINGXILEARN_AGENT_CACHE_VERIFY_MODE=strict
# --- Coze -------------------------------------------------------------------
LINGXILEARN_COZE_BOT_ID=
LINGXILEARN_COZE_BASE_URL=https://api.coze.cn
LINGXILEARN_COZE_TOKEN=
LINGXILEARN_COZE_TIMEOUT=45

# --- Web --------------------------------------------------------------------
# Only needed when the frontend is served from a different origin than the API
# (i.e. `npm run dev` against a separately hosted backend).
LINGXILEARN_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
LINGXILEARN_LOG_LEVEL=INFO

# --- LingxiIdentity BFF ---------------------------------------------------
# The API forwards the browser's host-only HttpOnly lingxi_session cookie to this BFF.
# In local Compose the BFF can run on the host at :8081; in production use its
# private service address. The browser never receives a bearer token.
LINGXILEARN_IDENTITY_BFF_URL=http://host.docker.internal:8081
LINGXILEARN_IDENTITY_BFF_TIMEOUT=10
# The browser always talks to the LingxiLearn same-origin proxy, which forwards
# /auth/* and /api/v1/* to LingxiIdentity. Do not set this to an identity
# subdomain: a cross-origin base breaks the host-only session cookie.
# Local Next dev forwards same-origin /api/* and /auth/* requests here.
LINGXILEARN_API_ORIGIN=http://127.0.0.1:8000
