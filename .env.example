# ---------------------------------------------------------------------------
# LingxiLearn configuration. Copy to .env and edit.
# Everything has a working default except the database password.
# ---------------------------------------------------------------------------

# --- Docker Compose ---------------------------------------------------------
POSTGRES_DB=lingxilearn
POSTGRES_USER=lingxilearn
POSTGRES_PASSWORD=change-me-before-you-deploy
LINGXILEARN_PORT=8080

# --- China mirror acceleration --------------------------------------------
# These are already the defaults. Change only if your server cannot access
# the selected mirror or you have an internal registry.
DOCKER_REGISTRY=docker.m.daocloud.io
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=mirrors.aliyun.com
ALPINE_MIRROR=mirrors.aliyun.com

# --- Storage ----------------------------------------------------------------
# Local development defaults to SQLite and needs no configuration at all.
# Compose overrides this with the PostgreSQL DSN.
# LINGXILEARN_DATABASE_URL=sqlite+aiosqlite:///./var/lingxilearn.sqlite3
# LINGXILEARN_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/lingxilearn

# --- Tutor brain ------------------------------------------------------------
# scripted | openai | coze
#
# `scripted` is the deterministic engine: no key, no network, fully
# reproducible. The teaching loop is complete without an LLM because grading,
# misconception detection, mastery and the evidence ledger are all computed —
# the model only chooses and phrases authored coaching material.
#
# If you select openai/coze but leave the credential empty, LingxiLearn falls
# back to `scripted` and says so in the UI rather than failing mid-lesson.
LINGXILEARN_BRAIN=scripted

# --- OpenAI-compatible provider ---------------------------------------------
# Works with OpenAI, DeepSeek, Qwen/DashScope compat, Moonshot, vLLM, Ollama…
# Switching provider is these three variables, not a code change.
LINGXILEARN_LLM_MODEL=gpt-4o-mini
LINGXILEARN_LLM_BASE_URL=https://api.openai.com/v1
LINGXILEARN_LLM_API_KEY=
LINGXILEARN_LLM_TEMPERATURE=0.3
LINGXILEARN_LLM_TIMEOUT=45

# --- Agent Task runtime ---------------------------------------------------
# All new intent/subagents share this DeepSeek-compatible model.
DS_API_KEY=
LINGXILEARN_AGENT_MODEL=deepseek-v4-flash
LINGXILEARN_AGENT_BASE_URL=https://api.deepseek.com
LINGXILEARN_AGENT_TIMEOUT=90
# Research has a larger node budget than intent/visual generation.
LINGXILEARN_AGENT_LECTURE_TIMEOUT=180
LINGXILEARN_AGENT_VISUAL_TIMEOUT=240
LINGXILEARN_AGENT_DECK_TIMEOUT=360
LINGXILEARN_AGENT_DECK_RECURSION_LIMIT=80
# Timeout for one public search/fetch request; the agent can continue with other sources.
LINGXILEARN_AGENT_WEB_TIMEOUT=20
LINGXILEARN_AGENT_CACHE_ENABLED=true
LINGXILEARN_AGENT_CACHE_VERIFY_MODE=strict
# Lecture Hook uses DeepSeek Responses API native web_search when the agent
# base URL is https://api.deepseek.com.

# --- Coze -------------------------------------------------------------------
LINGXILEARN_COZE_BOT_ID=
LINGXILEARN_COZE_BASE_URL=https://api.coze.cn
LINGXILEARN_COZE_TOKEN=
LINGXILEARN_COZE_TIMEOUT=45

# --- Web --------------------------------------------------------------------
# Only needed when the frontend is served from a different origin than the API
# (i.e. `npm run dev` against a separately hosted backend).
LINGXILEARN_CORS_ORIGINS=["http://localhost:3000"]
LINGXILEARN_LOG_LEVEL=INFO

# --- LingxiIdentity BFF ---------------------------------------------------
# The API forwards the browser's HttpOnly lingxi_session cookie to this BFF.
# In local Compose the BFF can run on the host at :8081; in production use its
# private service address. The browser never receives a bearer token.
LINGXILEARN_IDENTITY_BFF_URL=http://host.docker.internal:8081
LINGXILEARN_IDENTITY_BFF_TIMEOUT=10
# Local-only convenience: requests without a session use this fixed subject.
# Never enable this in a deployed environment.
# Local web development uses a frontend mock session by default. Set this to
# false when testing the real LingxiIdentity flow. The backend flag below is
# separately required when local API calls should also skip the BFF.
NEXT_PUBLIC_MOCK_AUTH=true
LINGXILEARN_INSECURE_DEV_AUTH=true
LINGXILEARN_DEV_SUBJECT=lingxilearn-dev

# The browser talks to the LingxiLearn same-origin proxy, which forwards
# /auth/* and /api/v1/* to LingxiIdentity. Do not put OIDC client secrets or
# provider tokens in NEXT_PUBLIC_* variables.
# Docker/static preview is same-origin; local Next dev points at the API port.
NEXT_PUBLIC_API_BASE=
