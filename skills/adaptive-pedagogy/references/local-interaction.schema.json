{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local-interaction.v1",
  "type": "object",
  "properties": {
    "required_reply": {
      "type": "boolean"
    },
    "prompt": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "confidence_chips": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "local_scaffolds": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "level",
          "label",
          "content"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "label": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}