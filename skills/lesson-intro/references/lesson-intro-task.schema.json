{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.example/schemas/lesson-intro-task.schema.json",
  "title": "Direct Lesson Introduction Task",
  "type": "object",
  "required": ["topic"],
  "properties": {
    "task_id": {"type": "string"},
    "topic": {"type": "string", "minLength": 1},
    "learning_objective": {"type": "string"},
    "course_context": {"type": "string"},
    "learner_level": {"type": "string", "default": "undergraduate"},
    "language": {"type": "string", "default": "zh-CN"},
    "target_duration_sec": {"type": "integer", "minimum": 20, "maximum": 180, "default": 75},
    "avoid": {"type": "array", "items": {"type": "string"}},
    "preferred_hook_type": {
      "enum": ["puzzle", "failure", "everyday", "intuition_trap", "extreme_scale", "definition_tension", "context_scene"]
    },
    "tone": {"type": "string"},
    "allow_interaction": {"type": "boolean"}
  },
  "not": {
    "anyOf": [
      {"required": ["candidate_count"]},
      {"required": ["preferred_hook_types"]},
      {"required": ["search_queries"]},
      {"required": ["research"]},
      {"required": ["source_records"]},
      {"required": ["search_results"]},
      {"required": ["query_results"]},
      {"required": ["aggregated_results"]},
      {"required": ["sources"]},
      {"required": ["claims"]}
    ]
  },
  "additionalProperties": true
}
