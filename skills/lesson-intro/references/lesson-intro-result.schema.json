{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.example/schemas/lesson-intro-result.schema.json",
  "title": "Lesson Introduction HTML Result",
  "description": "Optional envelope for the primary single-file HTML lesson introduction.",
  "type": "object",
  "required": ["html"],
  "properties": {
    "html": {
      "type": "string",
      "minLength": 1,
      "description": "A complete self-contained HTML document."
    },
    "topic": {"type": "string"},
    "status": {"enum": ["ok", "insufficient_evidence"]},
    "visible_citations": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "structured_data": {
      "type": "object",
      "description": "Optional machine-facing parameters and evidence; never learner-facing content.",
      "properties": {
        "input": {"type": "object"},
        "research": {
          "type": "object",
          "properties": {
            "claims": {"type": "array"},
            "sources": {"type": "array"}
          },
          "additionalProperties": true
        },
        "quality": {"type": "object"},
        "rendering": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
