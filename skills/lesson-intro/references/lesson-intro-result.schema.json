{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.example/schemas/lesson-intro-result.schema.json",
  "title": "Direct Lesson Introduction HTML Result",
  "description": "Optional envelope for the primary single-file HTML lesson introduction.",
  "type": "object",
  "required": ["html"],
  "properties": {
    "html": {
      "type": "string",
      "minLength": 1,
      "description": "A complete self-contained HTML document."
    },
    "topic": {"type": "string"},
    "status": {"const": "ok"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "structured_data": {
      "type": "object",
      "description": "Optional machine-facing parameters and evidence; never learner-facing content.",
      "properties": {
        "input": {"type": "object"},
        "editorial": {"type": "object"},
        "quality": {"type": "object"},
        "rendering": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
