{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.example/schemas/lesson-intro-result.schema.json",
  "title": "Lesson Introduction Result v1",
  "type": "object",
  "required": ["schema_version", "status", "topic", "selected_hook", "candidates", "research", "warnings"],
  "properties": {
    "schema_version": {"const": "lesson-intro-result.v1"},
    "status": {"enum": ["ok", "insufficient_evidence"]},
    "task_id": {"type": "string"},
    "topic": {"type": "string"},
    "selected_hook": {
      "type": "object",
      "required": ["title", "hook_type", "opening", "story", "question", "transition", "estimated_duration_sec", "why_this_hook_works"],
      "properties": {
        "title": {"type": "string"},
        "hook_type": {"type": "string"},
        "opening": {"type": "string"},
        "story": {"type": "string"},
        "question": {"type": "string"},
        "transition": {"type": "string"},
        "estimated_duration_sec": {"type": "integer", "minimum": 10, "maximum": 180},
        "visual_cue": {"type": "string"},
        "why_this_hook_works": {"type": "string"}
      },
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "hook_type", "score", "lesson_alignment", "curiosity", "evidence_strength"],
        "properties": {
          "title": {"type": "string"},
          "hook_type": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 100},
          "lesson_alignment": {"type": "number", "minimum": 0, "maximum": 100},
          "curiosity": {"type": "number", "minimum": 0, "maximum": 100},
          "evidence_strength": {"type": "number", "minimum": 0, "maximum": 100},
          "rejection_reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "research": {
      "type": "object",
      "required": ["claims", "sources", "search_angles"],
      "properties": {
        "search_angles": {"type": "array", "items": {"type": "string"}},
        "search_provider": {"type": "string"},
        "search_calls": {"type": "integer", "minimum": 0},
        "inspected_results": {"type": "integer", "minimum": 0},
        "fetched_sources": {"type": "integer", "minimum": 0},
        "unmet_targets": {"type": "array", "items": {"type": "string"}},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "claim", "status", "confidence", "source_ids"],
            "properties": {
              "claim_id": {"type": "string"},
              "claim": {"type": "string"},
              "status": {"enum": ["verified", "qualified", "rejected"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "source_ids": {"type": "array", "items": {"type": "string"}},
              "qualification": {"type": "string"}
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "title", "url", "tier"],
            "properties": {
              "source_id": {"type": "string"},
              "title": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "publisher": {"type": "string"},
              "published_at": {"type": "string"},
              "tier": {"enum": ["A", "B", "C", "D"]},
              "notes": {"type": "string"}
            }
          }
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
