{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lingxi:retrieval-practice-builder-task.v1",
  "title": "Retrieval practice builder task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "concept", "learning_objective", "target_type", "learner_evidence", "difficulty", "constraints"],
  "properties": {
    "schema_version": {"const": "retrieval-practice-builder-task.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "concept": {"type": "string", "minLength": 1},
    "learning_objective": {"type": "string", "minLength": 1},
    "taught_content": {"type": ["string", "object", "array"]},
    "target_type": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["retrieval", "near_transfer", "far_transfer", "boundary_case", "misconception_discriminator"]}
    },
    "learner_evidence": {
      "type": "object",
      "required": ["evidence_refs"],
      "properties": {
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_state": {"enum": ["not_observed", "emerging", "demonstrated", "misconception_evidence", "needs_recheck"]},
        "error_pattern": {"type": ["string", "null"]},
        "verification_debt": {"type": "boolean"},
        "last_task_type": {"type": ["string", "null"]},
        "assisted": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "difficulty": {
      "oneOf": [
        {"enum": ["easy", "medium", "hard"]},
        {"type": "object", "required": ["level"], "properties": {"level": {"enum": ["easy", "medium", "hard"]}}, "additionalProperties": true}
      ]
    },
    "constraints": {
      "type": "object",
      "required": ["max_candidates"],
      "properties": {
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 3},
        "language": {"const": "zh-CN"},
        "no_external_facts": {"type": "boolean"},
        "independent": {"type": "boolean"},
        "max_prompt_chars": {"type": "integer", "minimum": 1},
        "allowed_response_formats": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
