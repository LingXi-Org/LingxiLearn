{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lingxi:skill-eval-run.v1",
  "title": "Lingxi teaching Skill evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "skill", "cases"],
  "properties": {
    "schema_version": {"const": "skill-eval-run.v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "skill_path": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "task", "output"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "task": {"type": "object"},
          "output": {},
          "validator": {"type": "string"},
          "skill_path": {"type": "string"},
          "expectations": {"type": "object"},
          "trajectory": {"type": "object"},
          "outcome": {"type": "object"}
        }
      }
    }
  }
}
