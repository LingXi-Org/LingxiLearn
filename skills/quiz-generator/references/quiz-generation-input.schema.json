{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz-generation-input.v2",
  "title": "Quiz generation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "intent", "interactive_lecture_deck"],
  "properties": {
    "schema_version": {"const": "quiz-generation-input.v2"},
    "task_id": {"type": "string", "minLength": 1},
    "intent": {"type": "object"},
    "lesson_intro": {
      "description": "Optional raw single-file HTML, minimal envelope, or legacy structured intro.",
      "oneOf": [{"type": "string"}, {"type": "object"}]
    },
    "interactive_lecture_deck": {
      "type": "object",
      "required": ["schema_version"],
      "properties": {"schema_version": {"const": "interactive-lecture-deck-result.v2"}},
      "additionalProperties": true
    }
  }
}
