{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quiz-generation-result.v1",
  "title": "Quiz generation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "instructions", "questions", "total_points"],
  "properties": {
    "schema_version": {"const": "quiz-generation-result.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "instructions": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/question"}},
    "total_points": {"type": "integer", "minimum": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "options", "points", "answer", "explanation", "keywords"],
      "properties": {
        "id": {"type": "string", "pattern": "^q[0-9A-Za-z_-]+$"},
        "type": {"enum": ["single_choice", "multi_choice", "short_text"]},
        "prompt": {"type": "string", "minLength": 1},
        "options": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/option"}},
        "points": {"type": "integer", "minimum": 1, "maximum": 100},
        "answer": {},
        "explanation": {"type": "string"},
        "keywords": {"type": "array", "maxItems": 20, "items": {"type": "string"}}
      }
    }
  }
}
